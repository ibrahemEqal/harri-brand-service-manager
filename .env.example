HARRI_MODE=mock
PORT=3001
# Enable ONLY after explicit approval to read the real Harri Prep Brand.
HARRI_ALLOW_REAL_REQUESTS=false
# Header name and full value supplied by your approved auth/session contract.
# No authentication scheme is assumed. Never use VITE_ for secrets.
HARRI_AUTH_HEADER_NAME=
HARRI_AUTH_HEADER_VALUE=
# Optional session Cookie header, server-side only.
HARRI_COOKIE=
# Group writes remain disabled by default. Only enable after explicit authorization.
# Set this to the approved SSO test Brand ID; this allowlist does not verify SSO automatically.
HARRI_ALLOW_GROUP_CREATION=false
HARRI_GROUP_ALLOWED_BRAND_ID=
